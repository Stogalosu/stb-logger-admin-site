// use prisma-8

enum LineType {
  Tram       = "tram"
  Trolleybus = "trolleybus"
  Bus        = "bus"
  NightBus   = "night-bus"
  Subway     = "subway"
}

types {
  Geometry = postgis.Geometry(4326)
}

model Line {
  id   Int      @id @default(autoincrement())
  name String
  type LineType

  variants RouteVariant[]

  @@map("lines")
}

model RouteVariant {
  id           Int      @id @default(autoincrement())
  lineId       Int
  direction    String
  name         String
  scheduleType String
  path         Geometry

  line  Line        @relation(fields: [lineId], references: [id])
  stops RouteStop[]

  @@index([path], type: "gist")
  @@map("route_variants")
}

model Stop {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  location    Geometry
  underground Boolean

  routes RouteStop[]

  @@index([location], type: "gist")
  @@map("stops")
}

model RouteStop {
  variantId Int
  stopId    Int
  sequence  Int
  fraction  Float

  variant RouteVariant @relation(fields: [variantId], references: [id])
  stop    Stop         @relation(fields: [stopId], references: [id])

  @@id([variantId, sequence])
  @@map("route_stop")
}

model Metadata {
  key       String   @id
  value     String
  updatedAt DateTime @onCreate(now()) @onUpdate(now())

  @@map("metadata")
}
